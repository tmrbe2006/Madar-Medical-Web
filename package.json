{
  "name": "madar-medical-web",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --import tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node scripts/start.mjs",
    "setup": "node --import tsx server/setup.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "backup": "node scripts/backup.mjs"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "mssql": "^11.0.1",
    "mysql2": "^3.13.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/mssql": "^9.1.7",
    "@types/node": "^24.0.0",
    "jsdom": "^31.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.1.0"
  }
}
